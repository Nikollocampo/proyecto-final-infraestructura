# Recurso compartido agregado a /etc/samba/smb.conf

[hospital]
   comment = Carpeta compartida Hospital San Juan de Dios
   path = /srv/samba/hospital
   browseable = yes
   writable = yes
   guest ok = no
   valid users = @sambausers
   force group = sambausers
   create mask = 0660
   directory mask = 2770